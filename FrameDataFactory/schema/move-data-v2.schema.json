{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framedata.local/schema/move-data-v2.schema.json",
  "title": "Frame Data Character Moves V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "moves"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "moves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/move"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b"],
      "properties": {
        "b": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "h": {
          "const": true
        }
      }
    },
    "buttonPress": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/button"
      }
    },
    "commandStep": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/buttonPress"
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/commandStep"
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "raw": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "total": {
          "type": "integer"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "advantage": {
          "type": "integer"
        },
        "tags": {
          "$ref": "#/$defs/stringArray"
        },
        "raw": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "stringCommand": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "stance": {
          "$ref": "#/$defs/stringArray"
        },
        "hitLevel": {
          "$ref": "#/$defs/stringArray"
        },
        "impact": {
          "type": "integer"
        },
        "damage": {
          "$ref": "#/$defs/damage"
        },
        "block": {
          "$ref": "#/$defs/outcome"
        },
        "hit": {
          "$ref": "#/$defs/outcome"
        },
        "counterHit": {
          "$ref": "#/$defs/outcome"
        },
        "guardBurst": {
          "type": "integer"
        },
        "properties": {
          "$ref": "#/$defs/stringArray"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
